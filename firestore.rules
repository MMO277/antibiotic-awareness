rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() { return request.auth != null; }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid && uid.size() > 0;
    }

    function validUserDocWrite() {
      let d = request.resource.data;
      return (!('schedules' in d) || d.schedules is list)
        && (!('deletedScheduleIds' in d) || d.deletedScheduleIds is map)
        && (!('prescriptions' in d) || d.prescriptions is list)
        && (!('deletedPrescriptionIds' in d) || d.deletedPrescriptionIds is map)
        && (!('treatmentEvents' in d) || d.treatmentEvents is list)
        && (!('radarWorkspace' in d) || d.radarWorkspace is map)
        && (!('healthProfile' in d) || d.healthProfile is map)
        && (!('learnDone' in d) || d.learnDone is list);
    }

    function roleDocPath() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }

    // true only if the signed-in user has a roles/{uid} document whose role is in `list`
    function hasRole(list) {
      return isSignedIn() && exists(roleDocPath()) && get(roleDocPath()).data.role in list;
    }

    function isStaff() { return hasRole(['editor', 'reviewer', 'admin']); }
    function isReviewer() { return hasRole(['reviewer', 'admin']); }

    // Admin switch: show source-based records that are not clinically reviewed yet.
    // If the settings document does not exist, the switch counts as ON.
    function previewOn() {
      let p = /databases/$(database)/documents/settings/public;
      return !exists(p) || get(p).data.get('showUnreviewed', true) != false;
    }

    function validMedicine() {
      let d = request.resource.data;
      return d.status in ['draft', 'pending_review', 'approved', 'archived']
        && d.sources is list
        && d.brands is list
        && d.barcodes is list
        // previewPublic must be true only for draft/pending records that have a source
        && d.previewPublic is bool
        && d.previewPublic == ((d.status == 'draft' || d.status == 'pending_review') && d.sources.size() > 0)
        // approval needs at least one source, a review date and a reviewer name
        && (d.status != 'approved' || (
              d.sources.size() > 0
              && d.lastReviewed is string && d.lastReviewed.size() > 0
              && d.reviewedBy is string && d.reviewedBy.size() > 0));
    }

    // ---------- medicines ----------
    match /medicines/{id} {
      // The public can read approved records, and (while the admin switch is ON)
      // source-based records flagged previewPublic. Staff can read everything.
      allow read: if (resource != null
                      && (resource.data.status == 'approved'
                          || (resource.data.previewPublic == true && previewOn())))
                  || isStaff();

      // Editors may only save Draft / Pending Review.
      // Reviewers and admins may also approve and archive.
      allow create, update: if isStaff()
        && validMedicine()
        && (request.resource.data.status in ['draft', 'pending_review'] || isReviewer());

      allow delete: if hasRole(['admin']);
    }

    // ---------- site settings ----------
    match /settings/{doc} {
      allow read: if true;
      allow write: if hasRole(['admin']);
    }

    // ---------- roles (who is editor / reviewer / admin) ----------
    // The FIRST admin is created by hand in the Firebase console (see README).
    match /roles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || hasRole(['admin']));
      allow write: if hasRole(['admin']);
    }

    // ---------- personal patient data (strictly owner-only) ----------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUserDocWrite();
      allow delete: if isOwner(uid);
      match /{subcollection=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------- optional research survey ----------
    match /researchConfig/{doc} {
      allow read: if true;
      allow write: if hasRole(['admin']);
    }

    match /researchResponses/{id} {
      // Anonymous create is allowed only while the admin has switched the survey ON.
      allow create: if exists(/databases/$(database)/documents/researchConfig/main)
        && get(/databases/$(database)/documents/researchConfig/main).data.enabled == true
        && request.resource.data.keys().hasOnly(['phase', 'name', 'age', 'answers', 'consent', 'lang', 'createdAt'])
        && request.resource.data.keys().hasAll(['phase', 'name', 'age', 'answers', 'consent', 'lang', 'createdAt'])
        && request.resource.data.phase in ['pre', 'post']
        && request.resource.data.consent == true
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.age is int
        && request.resource.data.age >= 1
        && request.resource.data.age <= 120
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 30
        && request.resource.data.lang in ['ar', 'en']
        && request.resource.data.createdAt == request.time;
      allow read: if hasRole(['admin']);
      allow update: if false;
      allow delete: if hasRole(['admin']);
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
