rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() { return request.auth != null; }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid && uid.size() > 0;
    }

    function validUserDocWrite() {
      let d = request.resource.data;
      return (!('schedules' in d) || d.schedules is list)
          && (!('deletedScheduleIds' in d) || d.deletedScheduleIds is map)
          && (!('prescriptions' in d) || d.prescriptions is list)
          && (!('deletedPrescriptionIds' in d) || d.deletedPrescriptionIds is map)
          && (!('treatmentEvents' in d) || d.treatmentEvents is list)
          && (!('radarWorkspace' in d) || d.radarWorkspace is map)
          && (!('healthProfile' in d) || d.healthProfile is map)
          && (!('learnDone' in d) || d.learnDone is list);
    }

    function roleDocPath() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }

    function userHasRoleIn(allowedRoles) {
      return isSignedIn()
          && exists(roleDocPath())
          && (get(roleDocPath()).data.role in allowedRoles);
    }

    function isEditor() { return userHasRoleIn(['editor', 'admin']); }
    function isReviewer() { return userHasRoleIn(['reviewer', 'admin']); }
    function isAdmin() { return userHasRoleIn(['admin']); }

    function validMedicineSchema() {
      let d = request.resource.data;
      return d.genericName is string && d.genericName.size() > 0
          && d.status in ['draft', 'pending_review', 'approved', 'archived'];
    }

    // ---------- rules ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && validUserDocWrite();
      allow delete: if isAdmin();
    }

    match /medicines/{id} {
      allow read: if resource.data.status == 'approved' || isEditor() || isReviewer();
      allow create: if isEditor() && validMedicineSchema()
          && request.resource.data.status in ['draft', 'pending_review'];
      allow update: if (
            isEditor()
            && validMedicineSchema()
            && (
                 (resource.data.status in ['draft', 'pending_review'] && request.resource.data.status in ['draft', 'pending_review'])
              || (resource.data.status == 'approved' && request.resource.data.status == 'pending_review')
            )
          ) || (
            isReviewer()
            && validMedicineSchema()
            && request.resource.data.status in ['draft', 'pending_review', 'approved', 'archived']
          );
      allow delete: if isAdmin();
    }

    match /roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /surveyResponses/{id} {
      allow create: if request.resource.data.keys().hasAll(['createdMs', 'phase', 'age', 'answers'])
          && request.resource.data.createdMs is number
          && request.resource.data.phase in ['pre', 'post']
          && request.resource.data.age is number
          && request.resource.data.answers is map;
      allow read, update, delete: if isAdmin();
    }

    match /surveyConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assessmentPairs/{id} {
      allow create: if request.resource.data.keys().hasAll(['topicId', 'createdMs', 'preScore', 'preTotal', 'status'])
          && request.resource.data.topicId is string
          && request.resource.data.createdMs is number
          && request.resource.data.preScore is number
          && request.resource.data.preTotal is number
          && request.resource.data.status == 'started'
          && !('email' in request.resource.data)
          && !('name' in request.resource.data)
          && !('phone' in request.resource.data);

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'postScore', 'postTotal', 'scoreDelta', 'improved', 'completedMs', 'status', 'updatedAt'
          ])
          && request.resource.data.status in ['completed', 'abandoned']
          && request.resource.data.postScore is number;

      allow read, delete: if isAdmin();
    }

    match /learningAnalytics/{id} {
      allow create: if request.resource.data.keys().hasAll(['eventType', 'topicId', 'createdMs'])
          && request.resource.data.eventType in ['lesson_start', 'lesson_complete', 'quiz_start', 'quiz_complete']
          && request.resource.data.topicId is string
          && request.resource.data.createdMs is number;

      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
